<?xml version="1.0" ?>
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input><net-file value="aye_bottleneck_net.xml"/><route-files value="offpeak_demand_rou.xml"/><additional-files value="aye_additional_add.xml"/></input>
    <time><begin value="0"/><end value="5400"/><step-length value="0.1"/></time>
    <processing><lateral-resolution value="0.8"/><collision.action value="warn"/><collision.mingap-factor value="0"/></processing>
    <report><verbose value="true"/><no-step-log value="true"/></report>
    <random_number><seed value="42"/></random_number>
</configuration>
