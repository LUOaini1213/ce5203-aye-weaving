<?xml version='1.0' encoding='utf-8'?>
<configuration><input><net-file value="../../../sumo/peak/aye_bottleneck_net.xml" /><route-files value="../../../sumo/peak/peak_demand_rou.xml" /><additional-files value="additional.add.xml" /></input><time><begin value="0" /><end value="5400" /><step-length value="0.5" /></time><processing><lateral-resolution value="0.8" /><collision.action value="warn" /><collision.mingap-factor value="0" /><time-to-teleport value="120.0" /></processing><report><verbose value="false" /><no-step-log value="true" /><log value="sumo.log" /><error-log value="warnings.log" /></report><random_number><seed value="42" /></random_number><output><tripinfo-output value="tripinfo.xml" /><tripinfo-output.write-unfinished value="true" /></output></configuration>